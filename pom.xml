<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.whaleal</groupId>
    <artifactId>rds-sync</artifactId>
    <packaging>pom</packaging>
    <version>1.0.0-SNAPSHOT</version>
    <name>rds-sync</name>
    <description>Relational DB sync (Hybrid: PhotonT assets + mongo-sync-style orchestration)</description>

    <modules>
        <module>rds-transfer-model</module>
        <module>rds-common</module>
        <module>rds-core</module>
        <module>rds-mysql-source</module>
        <module>rds-mysql-sink</module>
        <module>rds-oracle-source</module>
        <module>rds-pg-source</module>
        <module>rds-kafka-sink</module>
        <module>rds-sync-client</module>
        <!-- Mongo / HDFS / Hadoop removed; relational DB only -->
    </modules>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <rds.sync.version>1.0.0-SNAPSHOT</rds.sync.version>
        <junit.version>4.13.2</junit.version>
        <!-- Security floors (Java 8). Versions chosen to cover open Dependabot alerts. -->
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <commons-io.version>2.14.0</commons-io.version>
        <gson.version>2.8.9</gson.version>
        <guava.version>32.1.3-jre</guava.version>
        <log4j.version>2.26.1</log4j.version>
        <postgresql.version>42.7.13</postgresql.version>
        <mysql-connector.version>8.4.0</mysql-connector.version>
        <c3p0.version>0.14.2</c3p0.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
